# Copy this to .env and fill in your values.

# === AgentPhone ===
# API key from https://agentphone.ai (paid platform)
AGENTPHONE_API_KEY=sk_live_...

# The "coordinator" agent — created via setup_agent.py
AGENTPHONE_AGENT_ID=

# Voice number attached to the coordinator agent (outbound calls)
AGENTPHONE_FROM_NUMBER=+1...
AGENTPHONE_FROM_NUMBER_ID=

# Shared iMessage line ID (created via the AP2IMSG redeem flow)
AGENTPHONE_NUMBER_ID=

# === City Roleplay agent (the "called" side) ===
# Created via setup_city_agent.py
CITY_AGENT_ID=
CITY_PHONE_NUMBER=+1...

# === Demo test phone ===
# An iPhone whitelisted on the shared iMessage line; the agent texts/calls this.
TEST_PHONE=+1...

# === LLM keys ===
# Gemini key for natural-language parsing in inbox_listener.py
GEMINI_API_KEY=AIza...

# Browser-use cloud LLM key for navigate_permit_wizard
BROWSER_USE_API_KEY=bu_...
